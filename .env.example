# Copy this to .env and fill in your keys
# Only OPENAI_API_KEY is required for Mem0 self-hosted

OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Mem0 platform (if using hosted Mem0 instead of self-hosted)
# MEM0_API_KEY=m0-your-mem0-key-here

# Optional: Zep Cloud
# ZEP_API_KEY=your-zep-key-here

# Optional: Letta Cloud
# LETTA_API_KEY=your-letta-key-here
